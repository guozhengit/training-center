# Copy to .env in this directory. The scripts load it from any working directory.
# Values are literal KEY=value, optionally enclosed in matching quotes.
# Do not use shell commands, variable expansion, export, or inline comments.
# Existing environment variables take precedence. Keep this file private (chmod 600).
TRAINING_DATA_DIR=/home/docker/training-data
BACKUP_DIR=/home/docker/backups
KEEP=7
TRAINING_PORT=8080
# Use 127.0.0.1 when a reverse proxy runs on this host.
TRAINING_BIND_ADDRESS=0.0.0.0
TRAINING_API_KEY=
# Web heap only; Maven and test JVMs share the container's total memory limit.
JAVA_OPTS=-Xms128m -Xmx512m -XX:+UseContainerSupport -Duser.timezone=Asia/Shanghai
TRAINING_MEMORY_LIMIT=2G
TRAINING_CPU_LIMIT=2.0
BASE_IMAGE=training-center-base:17
# Preserve the legacy Compose project identity during existing installations.
COMPOSE_PROJECT_NAME=deploy
TRAINING_HEALTH_TIMEOUT=180
